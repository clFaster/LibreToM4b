    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch LibreToM4b: convert sample",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/LibreToM4b/bin/Debug/net10.0/LibreToM4b.dll",
            "args": "convert \"InputFolder\"",
            "cwd": "${workspaceFolder}/LibreToM4b",
            "stopAtEntry": false,
            "console": "integratedTerminal"
        }
    ]
}